FOUNDATION_VERSION=v1.7.12
PLUGIN_NAME="FlavorPress Content Analyzer"
PLUGIN_SLUG=flavorpress-content-analyzer
MAIN_PLUGIN_FILE=flavorpress-content-analyzer.php
README_FILE=readme.txt
ZIP_FILE=flavorpress-content-analyzer-wordpress.zip
PHP_VERSION=8.1
NODE_VERSION=22
PLUGIN_RUNTIME_UPDATE_PROVIDER=none
REST_OPERATIONS_PACK_ENABLED=false
ADMIN_UI_PACK_ENABLED=false
WP_PLUGIN_BASE_SECURITY_SUPPRESSIONS_FILE=.wp-plugin-base-security-suppressions.json
DISTIGNORE_FILE=.distignore
PACKAGE_INCLUDE=assets,block.json,flavorpress-content-analyzer.php,readme.txt,LICENSE
PACKAGE_EXCLUDE=src,scripts,package.json,vite.config.ts
BUILD_SCRIPT=scripts/build-assets.sh
